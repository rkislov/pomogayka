APP_NAME=Помогайка
ADDR=:8080
# SQLite (по умолчанию)
DATABASE_URL=file:data/pomogayka.db?_pragma=busy_timeout(5000)&_pragma=foreign_keys(ON)
# PostgreSQL:
# DATABASE_URL=postgres://pomogayka:pomogayka@localhost:5432/pomogayka?sslmode=disable

# Для утилиты миграции SQLite -> PostgreSQL:
# SQLITE_DATABASE_URL=file:data/pomogayka.db?_pragma=busy_timeout(5000)&_pragma=foreign_keys(ON)
# POSTGRES_DATABASE_URL=postgres://pomogayka:pomogayka@localhost:5432/pomogayka?sslmode=disable
SESSION_SECRET=change-me-in-production
SECURE_COOKIES=false
SESSION_HOURS=168
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
ADMIN_FULL_NAME=Администратор

# Telegram-бот (long polling в том же процессе)
# Создайте бота у @BotFather и вставьте токен.
TELEGRAM_BOT_TOKEN=
# По умолчанию включается автоматически, если токен задан.
# TELEGRAM_BOT_ENABLED=true

# Jabber / XMPP бот (клиентский аккаунт бота)
# JABBER_JID=pomogayka-bot@xmpp.example.com
# JABBER_PASSWORD=secret
# JABBER_HOST=xmpp.example.com:5222
# JABBER_START_TLS=true
# JABBER_NO_TLS=false
# JABBER_INSECURE_TLS=false
# JABBER_ENABLED=true

